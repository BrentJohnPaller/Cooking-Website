@{
    ViewData["Title"] = "About Us";
}

<section class="page-header">
    <div class="container">
        <h1>About FlavorCraft</h1>
        <p>Our story, our mission, our love for food.</p>
    </div>
</section>

<section class="section">
    <div class="container about-content">
        <div class="about-text">
            <h2>We Believe Everyone Can Cook</h2>
            <p>FlavorCraft was born from a simple idea: great food shouldn't be intimidating. Whether you're a complete beginner who burns toast or an experienced home cook looking for new inspiration, this is your kitchen community.</p>
            <p>In 2026, the world has changed dramatically. The pandemic taught us to cook at home more, appreciate simple ingredients, and find joy in the ritual of preparing meals for ourselves and loved ones. FlavorCraft captures that spirit.</p>
            <h2>What We Offer</h2>
            <ul class="about-list">
                <li>🍳 Hundreds of tested, reliable recipes</li>
                <li>📸 Step-by-step photo guides</li>
                <li>👨‍🍳 Professional cooking tips and techniques</li>
                <li>🏷️ Recipes for every skill level and dietary need</li>
                <li>🌍 Dishes from cuisines around the world</li>
            </ul>
        </div>
        <div class="about-stats">
            <div class="stat-box">
                <span class="big-num">60+</span>
                <span>Recipes</span>
            </div>
            <div class="stat-box">
                <span class="big-num">60+</span>
                <span>Home Cooks</span>
            </div>
            <div class="stat-box">
                <span class="big-num">6</span>
                <span>Categories</span>
            </div>
            <div class="stat-box">
                <span class="big-num">100%</span>
                <span>Made with Love</span>
            </div>
        </div>
    </div>
</section>
