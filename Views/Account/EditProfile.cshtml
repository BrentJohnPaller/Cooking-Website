@model CookingWebsite.Models.EditProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
}
<section class="page-header community-header">
    <div class="container">
        <h1>Edit Profile</h1>
        <p>Update your display name, photo, and bio.</p>
    </div>
</section>
<section class="section">
    <div class="container" style="max-width:560px;">
        <div class="auth-card">
            @if (TempData["Success"] != null)
            {
                <div class="alert-success">✅ @TempData["Success"]</div>
            }
            <form asp-action="EditProfile" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="form-group" style="align-items:center;">
                    <label>Profile Photo</label>
                    <div class="profile-photo-upload" onclick="document.getElementById('profilePhotoInput').click()">
                        <input type="file" id="profilePhotoInput" name="ProfilePhoto" accept="image/*"
                               style="display:none" onchange="previewProfilePhoto(this)" />
                        @if (!string.IsNullOrEmpty(Model.CurrentPhotoUrl))
                        {
                            <img id="profilePhotoPreview" src="@Model.CurrentPhotoUrl" alt="Profile" />
                        }
                        else
                        {
                            <img id="profilePhotoPreview" style="display:none;" />
                            <div id="profilePhotoPlaceholder" class="profile-upload-placeholder">
                                <span style="font-size:2rem;">📷</span>
                                <span>Click to upload</span>
                            </div>
                        }
                    </div>
                    <small>JPG, PNG, WEBP — max 10MB</small>
                </div>
                <div class="form-group">
                    <label>Display Name</label>
                    <input asp-for="DisplayName" class="form-input" placeholder="Your name" />
                </div>
                <div class="form-group">
                    <label>Bio</label>
                    <textarea asp-for="Bio" class="form-textarea" rows="3"
                              placeholder="Tell the community a little about yourself..."></textarea>
                </div>
                <div class="form-actions">
                    <a asp-action="Profile" class="btn-outline">Cancel</a>
                    <button type="submit" class="btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</section>
@section Scripts {
    <script>
        function previewProfilePhoto(input) {
            const file = input.files[0];
            if (!file) return;
            const img = document.getElementById('profilePhotoPreview');
            const placeholder = document.getElementById('profilePhotoPlaceholder');
            const reader = new FileReader();
            reader.onload = e => {
                img.src = e.target.result;
                img.style.display = 'block';
                if (placeholder) placeholder.style.display = 'none';
            };
            reader.readAsDataURL(file);
        }
    </script>
}