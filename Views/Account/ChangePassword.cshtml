@model CookingWebsite.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<section class="page-header community-header">
    <div class="container">
        <h1>Change Password</h1>
        <p>Enter your current password and choose a new one.</p>
    </div>
</section>

<section class="section">
    <div class="container" style="max-width:480px;">
        <div class="auth-card">

            @if (TempData["Success"] != null)
            {
                <div class="alert-success">✅ @TempData["Success"]</div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert-error">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>⚠️ @error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label>Current Password</label>
                    <input asp-for="CurrentPassword" type="password" class="form-input" placeholder="Enter current password" />
                </div>

                <div class="form-group">
                    <label>New Password</label>
                    <input asp-for="NewPassword" type="password" class="form-input" placeholder="At least 6 characters" />
                </div>

                <div class="form-group">
                    <label>Confirm New Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-input" placeholder="Repeat new password" />
                </div>

                <div class="form-actions">
                    <a asp-action="Profile" class="btn-outline">Cancel</a>
                    <button type="submit" class="btn-primary">🔒 Update Password</button>
                </div>
            </form>
        </div>
    </div>
</section>