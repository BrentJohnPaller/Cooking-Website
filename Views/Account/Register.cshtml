@model CookingWebsite.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<section class="page-header community-header">
    <div class="container">
        <h1>Create Account</h1>
        <p>Join the FlavorCraft community today.</p>
    </div>
</section>

<section class="section">
    <div class="container" style="max-width:480px;">
        <div class="auth-card">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert-error">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>⚠️ @error.ErrorMessage</div>
                    }
                </div>
            }
            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label>Display Name</label>
                    <input asp-for="DisplayName" class="form-input" placeholder="e.g. Maria Santos" />
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <input asp-for="Email" class="form-input" placeholder="you@email.com" />
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input asp-for="Password" type="password" class="form-input" placeholder="Min. 6 characters" />
                </div>
                <div class="form-group">
                    <label>Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-input" placeholder="Repeat your password" />
                </div>
                <button type="submit" class="btn-primary" style="width:100%;margin-top:1rem;">Create Account</button>
            </form>
            <p style="text-align:center;margin-top:1.25rem;color:var(--text-light);">
                Already have an account? <a asp-action="Login" style="color:var(--orange);font-weight:700;">Log in</a>
            </p>
        </div>
    </div>
</section>